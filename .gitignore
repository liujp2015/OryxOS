# ===== OryxOS root .gitignore =====

# --- IDE / Editor ---
.idea/
*.iml
*.iws
*.ipr
.vscode/
.project
.classpath
.settings/
.factorypath
nbproject/
nb-configuration.xml

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# --- Logs / temp ---
*.log
logs/
*.tmp
*.bak
*.swp
*.swo
*~

# --- Maven ---
**/target/
!**/target/maven-archiver/
!**/target/classes/
!**/target/surefire-reports/
!**/target/test-classes/
.mvn/wrapper/maven-wrapper.jar

# --- Java ---
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*

# --- Node / VitePress (mirrors website/.gitignore for safety at root too) ---
**/node_modules/
**/.vitepress/cache/
**/.vitepress/dist/

# --- OryxOS workspace (runtime state, user-specific) ---
.oryxos/

# --- Claude Code cache ---
.claude/